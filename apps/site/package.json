{
  "name": "@sneakers-pam/site",
  "private": true,
  "type": "module",
  "description": "The Sneakers-PAM product site, www.sneakers-pam.com.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/build-security-pdf.mjs",
    "typecheck": "react-router typegen && tsc",
    "test": "node --experimental-strip-types --test app/*.test.ts app/content/*.test.ts app/content/trust/*.test.ts scripts/*.test.mjs",
    "lint": "eslint .",
    "check:evidence": "node --experimental-strip-types scripts/check-trust-evidence.mjs",
    "preview": "npx serve build/client"
  },
  "dependencies": {
    "@sneakers-pam/brand": "*",
    "@sneakers-pam/frame": "*",
    "@react-router/node": "^7.18.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.4",
    "isbot": "^5"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.4",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
